---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  /** 文章页自己用网格排正文和目录，不需要外层再限宽 */
  fullWidth?: boolean;
}

const { title, description, type, publishedDate, fullWidth = false } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead {title} {description} {type} {publishedDate} />
  </head>
  <body>
    <a href="#main" class="skip-link">跳到正文</a>
    <Header />
    <main id="main" class={fullWidth ? 'shell' : 'shell column-inner'}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  /* 内容收在与文章正文等宽的列里，右侧留白正好是文章页目录栏的位置 */
  .column-inner > :global(*) {
    max-width: var(--column);
  }
</style>
