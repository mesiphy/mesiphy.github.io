---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  /** 文章页需要更宽的外壳来容纳侧边目录 */
  wide?: boolean;
}

const { title, description, type, publishedDate, wide = false } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead {title} {description} {type} {publishedDate} />
  </head>
  <body>
    <a href="#main" class="skip-link">跳到正文</a>
    <Header />
    <main id="main" class={wide ? 'shell shell-wide' : 'shell'}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .shell-wide {
    max-width: 64rem;
  }
</style>
