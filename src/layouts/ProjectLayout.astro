---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<BaseLayout {title} {description} {image} fullWidth>
  <article class="project-case" data-pagefind-body>
    <slot />
  </article>
</BaseLayout>

<style>
  .project-case {
    width: 100%;
    min-width: 0;
  }
</style>
