---
interface Props {
  current: number;
  total: number;
}

const { current, total } = Astro.props;

// 第 1 页是 /posts/，其余是 /posts/page/N/。
// 这样列表首页有干净的 URL，也不会和 /posts/[slug]/ 撞车。
const pageUrl = (n: number) => (n === 1 ? '/posts/' : `/posts/page/${n}/`);
---

{
  total > 1 && (
    <nav class="pagination" aria-label="翻页">
      {current > 1 ? (
        <a href={pageUrl(current - 1)} rel="prev">
          ← 上一页
        </a>
      ) : (
        <span class="disabled">← 上一页</span>
      )}

      <span class="counter">
        {String(current).padStart(2, '0')} / {String(total).padStart(2, '0')}
      </span>

      {current < total ? (
        <a href={pageUrl(current + 1)} rel="next">
          下一页 →
        </a>
      ) : (
        <span class="disabled">下一页 →</span>
      )}
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  a {
    text-decoration: none;
    color: var(--ink-soft);
  }

  a:hover {
    color: var(--stamp);
  }

  .disabled {
    color: var(--rule);
  }

  .counter {
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }
</style>
