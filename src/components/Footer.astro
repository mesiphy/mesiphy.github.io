---
import { SITE_AUTHOR } from '../consts';

const year = new Date().getFullYear();
---

<footer class="shell">
  <div class="perf">
    <span>· · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · ·</span>
  </div>
  <div class="meta">
    <p>© {year} {SITE_AUTHOR} · 惚恍，探索仍在继续</p>
    <p class="links">
      <a href="/rss.xml">RSS</a>
      <span aria-hidden="true">·</span>
      <a href="https://github.com/mesiphy" rel="me">GitHub</a>
    </p>
  </div>
</footer>

<style>
  footer {
    margin-top: 4rem;
    padding-bottom: 3rem;
  }

  /* 模拟连续打印纸的撕裂虚线 */
  .perf {
    overflow: hidden;
    white-space: nowrap;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1;
    margin-bottom: 1rem;
    user-select: none;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  .meta p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: var(--ink-faint);
  }

  .links {
    display: flex;
    gap: 0.6rem;
  }

  .links a {
    color: var(--ink-muted);
    border: none;
    text-decoration: none;
  }

  .links a:hover {
    color: var(--stamp);
  }
</style>
