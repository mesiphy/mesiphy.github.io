---
import { SITE_TITLE, SITE_DESCRIPTION, SITE_AUTHOR } from '../consts';
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/600.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** 文章页传 'article'，其余页面用默认值 */
  type?: 'website' | 'article';
  publishedDate?: Date;
}

const { title, description = SITE_DESCRIPTION, type = 'website', publishedDate } = Astro.props;

// Astro.site 在 astro.config.mjs 里已配置，这里可以安全构造绝对 URL
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE_AUTHOR} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="zh_CN" />
{publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />

<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
<meta name="generator" content={Astro.generator} />

{/* 内联执行，避免暗色模式在首屏出现白闪 */}
<script is:inline>
  (() => {
    const stored = localStorage.getItem('theme');
    const theme =
      stored ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.dataset.theme = theme;
  })();
</script>
