---
import { SITE_TITLE, NAV_LINKS, CONTENT_NAV_LINKS, CATEGORIES, type CategorySlug } from '../consts';
interface Props { immersive?: boolean; currentCategory?: CategorySlug }
const { immersive = false, currentCategory } = Astro.props;
const path = Astro.url.pathname;
const activeCategory = currentCategory ?? CATEGORIES.find((category) => path.startsWith(category.href))?.slug;
const contentPaths = ['/posts/', '/projects/', '/graph/', '/archive/', '/tags/', '/search/'];
const inContent = !!activeCategory || contentPaths.some((prefix) => path.startsWith(prefix));
function isCurrent(href: string) {
  if (href === '/') return path === '/';
  const category = CATEGORIES.find((item) => item.href === href);
  if (category) return category.slug === activeCategory;
  return path.startsWith(href);
}
function isSecondaryCurrent(href: string) {
  if (href === '/posts/') return path === href || path.startsWith('/posts/page/');
  return path.startsWith(href);
}
---
<header class:list={['site-header', 'shell', { immersive }]}>
  <div class="header-row">
    {!immersive && <a href="/" class="wordmark">{SITE_TITLE}</a>}
    <nav class="primary-nav" aria-label="主导航">
      <ul>{NAV_LINKS.map((link) => (
        <li><a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a></li>
      ))}</ul>
    </nav>
  </div>
  {inContent && (
    <nav class="secondary" aria-label="内容导航">
      <ul>{CONTENT_NAV_LINKS.map((link) => (
        <li><a href={link.href} aria-current={isSecondaryCurrent(link.href) ? 'page' : undefined}>{link.label}</a></li>
      ))}</ul>
    </nav>
  )}
</header>
<style>
  .site-header { padding-top: 1.35rem; }
  .header-row { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 1rem; align-items: center; padding-block: .35rem 1rem; border-bottom: 1px solid var(--rule); }
  .wordmark { font-family: var(--font-editorial); font-size: 1.65rem; font-weight: 600; letter-spacing: .06em; text-decoration: none; justify-self: start; }
  nav ul { display: flex; flex-wrap: wrap; gap: .25rem 1.8rem; padding: 0; margin: 0; list-style: none; }
  nav a { display: inline-block; white-space: nowrap; padding: .45rem .15rem; color: var(--ink-muted); font-family: var(--font-ui); font-size: .9rem; letter-spacing: .08em; text-decoration: none; border-bottom: 2px solid transparent; }
  nav a:hover { color: var(--accent); }
  nav a[aria-current='page'] { color: var(--accent); border-bottom-color: currentColor; }
  .secondary { padding-block: .5rem; border-bottom: 1px solid var(--rule); }
  .secondary ul { flex-wrap: wrap; gap: .15rem 1.4rem; }
  .secondary a { font-size: .78rem; padding-block: .25rem; }
  .immersive { padding-top: 1.5rem; }
  .immersive .header-row { display: flex; justify-content: center; border: 0; padding: 0; }
  .immersive nav ul { justify-content: center; }
  .immersive nav a { color: rgb(255 255 255 / .8); }
  .immersive nav a:hover, .immersive nav a[aria-current='page'] { color: #fff; }
  @media (max-width: 40rem) {
    .site-header { padding-top: .8rem; }
    .header-row { grid-template-columns: minmax(0, 1fr); gap: .4rem; }
    .wordmark { grid-column: 1; grid-row: 1; }
    .primary-nav { grid-column: 1 / -1; grid-row: 2; }
    nav ul { gap: .15rem 1rem; }
    nav a { font-size: .82rem; }
    .wordmark { font-size: 1.3rem; }
    .immersive { padding-top: 1.25rem; }
    .immersive nav ul { gap: .15rem 1rem; }
  }
</style>
