---
import { SITE_TITLE, NAV_LINKS, WRITING_NAV_LINKS } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
interface Props { immersive?: boolean }
const { immersive = false } = Astro.props;
const path = Astro.url.pathname;
const writingPaths = ['/writing/', '/posts/', '/categories/', '/projects/', '/graph/', '/archive/', '/tags/', '/search/'];
const inWriting = writingPaths.some((prefix) => path.startsWith(prefix));
function isCurrent(href: string) {
  if (href === '/') return path === '/';
  if (href === '/writing/') return inWriting;
  return path.startsWith(href);
}
function isSecondaryCurrent(href: string) {
  return path.startsWith(href) || (href === '/posts/' && path.startsWith('/categories/'));
}
---
<header class:list={['site-header', 'shell', { immersive }]}>
  <div class="header-row">
    {!immersive && <a href="/" class="wordmark">{SITE_TITLE}</a>}
    <nav aria-label="主导航">
      <ul>{NAV_LINKS.map((link) => (
        <li><a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a></li>
      ))}</ul>
    </nav>
    {!immersive && <div class="theme"><ThemeToggle /></div>}
  </div>
  {inWriting && (
    <nav class="secondary" aria-label="图文导航">
      <ul>{WRITING_NAV_LINKS.map((link) => (
        <li><a href={link.href} aria-current={isSecondaryCurrent(link.href) ? 'page' : undefined}>{link.label}</a></li>
      ))}</ul>
    </nav>
  )}
</header>
<style>
  .site-header { padding-top: 1.35rem; }
  .header-row { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: center; padding-block: .35rem 1rem; border-bottom: 1px solid var(--rule); }
  .wordmark { font-family: var(--font-editorial); font-size: 1.65rem; font-weight: 600; letter-spacing: .06em; text-decoration: none; justify-self: start; }
  .theme { justify-self: end; }
  nav ul { display: flex; gap: 1.8rem; padding: 0; margin: 0; list-style: none; }
  nav a { display: inline-block; padding: .45rem .15rem; color: var(--ink-muted); font-family: var(--font-ui); font-size: .9rem; letter-spacing: .08em; text-decoration: none; border-bottom: 2px solid transparent; }
  nav a:hover { color: var(--accent); }
  nav a[aria-current='page'] { color: var(--accent); border-bottom-color: currentColor; }
  .secondary { padding-block: .5rem; border-bottom: 1px solid var(--rule); }
  .secondary ul { flex-wrap: wrap; gap: .15rem 1.4rem; }
  .secondary a { font-size: .78rem; padding-block: .25rem; }
  .immersive { padding-top: 1.5rem; }
  .immersive .header-row { display: flex; justify-content: center; border: 0; padding: 0; }
  .immersive nav a { color: rgb(255 255 255 / .8); }
  .immersive nav a:hover, .immersive nav a[aria-current='page'] { color: #fff; }
  @media (max-width: 40rem) {
    .site-header { padding-top: .8rem; }
    .header-row { gap: .65rem; }
    nav ul { gap: 1rem; }
    nav a { font-size: .82rem; }
    .wordmark { font-size: 1.3rem; }
    .immersive { padding-top: 1.25rem; }
    .immersive nav ul { gap: 2.25rem; }
  }
</style>
