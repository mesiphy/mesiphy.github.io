---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_AUTHOR } from '../consts';
import { HOME } from '../home.config';
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={SITE_TITLE} image={HOME.desktopImage} /></head>
  <body class="home-scene" style={`--home-position: ${HOME.desktopPosition}; --home-mobile-position: ${HOME.mobilePosition}`}>
    <a href="#main" class="skip-link">跳到正文</a>
    <picture class="backdrop" aria-hidden="true">
      <source media="(max-width: 40rem)" srcset={HOME.mobileImage} />
      <img src={HOME.desktopImage} alt="" fetchpriority="high" decoding="async" />
    </picture>
    <Header immersive />
    <main id="main" class="home-main">
      <div class="home-copy">
        <h1>{SITE_TITLE}</h1>
        <p>{HOME.description}</p>
        <div class="home-actions">
          <a href="/music/" class="primary">听音乐</a>
          <a href="/writing/">读图文</a>
        </div>
      </div>
    </main>
    <footer class="home-footer">
      <span>© {year} {SITE_AUTHOR}</span>
      <div><a href="/about/">关于</a><span aria-hidden="true">·</span><a href="https://github.com/mesiphy" rel="me">GitHub</a></div>
    </footer>
  </body>
</html>
<style>
  :global(body.home-scene) { display: grid; grid-template-rows: auto 1fr auto; min-height: 100svh; background: #403437; color: #f8f7f3; --accent: #f8f7f3; }
  :global(body.home-scene)::before { display: none; }
  .backdrop { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .backdrop::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(28 17 28 / .46), rgb(28 17 28 / .38) 42%, rgb(18 19 27 / .25) 68%, rgb(18 19 27 / .45)); }
  .backdrop img { width: 100%; height: 100%; object-fit: cover; object-position: var(--home-position); }
  .home-main { display: grid; place-items: start center; padding: clamp(1.5rem, 6svh, 4rem) 1.25rem 5rem; text-align: center; }
  .home-copy { width: 100%; }
  h1 { font-size: clamp(4.5rem, 7vw, 7rem); font-weight: 400; line-height: 1.3; letter-spacing: .12em; padding-left: .12em; color: #fff; text-shadow: 0 2px 24px rgb(35 18 30 / .12); }
  .home-copy p { margin: 1.1rem auto 0; font-size: clamp(.85rem, 1.3vw, 1.1rem); line-height: 2; letter-spacing: .1em; color: rgb(255 255 255 / .94); max-width: 30em; text-wrap: balance; }
  .home-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 1rem; margin-top: 1.25rem; }
  .home-actions a { min-width: 9rem; padding: .6rem 1.5rem; border: 1px solid rgb(255 255 255 / .78); border-radius: 4px; text-decoration: none; color: #fff; font-family: var(--font-ui); font-size: .85rem; letter-spacing: .14em; background: rgb(40 30 38 / .15); transition: background .2s, transform .2s; }
  .home-actions .primary { background: rgb(255 255 255 / .85); color: #403437; }
  .home-actions a:hover { background: #fff; color: #403437; transform: translateY(-2px); }
  .home-footer { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.5rem 2.25rem; color: rgb(255 255 255 / .85); font-family: var(--font-ui); font-size: .75rem; }
  .home-footer div { display: flex; gap: .7rem; }
  .home-footer a { color: inherit; text-decoration: none; }
  .home-footer a:hover { color: #fff; }
  @media (max-width: 40rem) {
    .backdrop img { object-position: var(--home-mobile-position); }
    .home-main { padding-top: 9svh; }
    .home-actions { gap: .8rem; margin-top: 1.6rem; }
    .home-actions a { min-width: 7.5rem; padding-inline: 1rem; }
    .home-footer { padding: 1.25rem; font-size: .7rem; }
  }
</style>
