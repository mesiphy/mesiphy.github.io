---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import KnowledgeGraph from '../components/KnowledgeGraph.astro';
import { SITE_TITLE, GRAPH } from '../consts';
import { getPosts, groupByCategory } from '../lib/posts';
import { getCategoryGraphs } from '../lib/graph';

const posts = await getPosts();
const latest = posts.slice(0, 5);
const grouped = groupByCategory(posts);
const graphs = getCategoryGraphs(
  new Map(grouped.map(({ category, posts: items }) => [category.name, items.length])),
);
---

{/* fullWidth：首页自己用网格排主列和右栏，不要外层再限宽 */}
<BaseLayout title={SITE_TITLE} fullWidth>
  <div class="home">
    <section class="masthead">
      <p class="masthead-kicker">学习记录 · 项目实践 · 产品思考</p>
      <h1 class="masthead-title">{SITE_TITLE}</h1>
      <p class="masthead-lede">记录有价值的探索，留下有价值的问题，继续未竟的道路。</p>
    </section>

    {/* 宽屏时贴在右栏顶部，窄屏时落到页面末尾当一张站点地图 */}
    <aside class="rail" aria-label={GRAPH.title}>
      <div class="rail-inner">
        <h2 class="section-title">{GRAPH.title}</h2>
        <div class="rail-stack">
          {graphs.map((graph) => <KnowledgeGraph variant="rail" {graph} />)}
        </div>
        <p class="rail-note">
          <a href={GRAPH.href}>看大图 →</a>
        </p>
      </div>
    </aside>

    <div class="main">
      <hr class="rule-perforated" />

      <section class="categories" aria-label="栏目">
        {
          grouped.map(({ category, posts: items }) => (
            <a href={`/categories/${category.slug}/`} class="cat">
              <span class="cat-name">{category.name}</span>
              <span class="cat-desc">{category.description}</span>
              <span class="cat-count">{String(items.length).padStart(2, '0')} 篇</span>
            </a>
          ))
        }
      </section>

      <section class="featured-project" aria-labelledby="featured-title">
        <div class="featured-copy">
          <p class="featured-label">精选项目 · AI 产品工程</p>
          <h2 id="featured-title">LearnBranch</h2>
          <p>把线性的 AI 对话，变成可追溯的学习树。</p>
          <a href="/projects/learnbranch/">阅读完整案例 →</a>
        </div>
        <div class="featured-proof" aria-label="项目摘要">
          <span>产品判断</span>
          <span>AI 协作编排</span>
          <span>Windows 验收</span>
        </div>
      </section>

      <section class="latest">
        <h2 class="section-title">最新</h2>
        {
          latest.length > 0 ? (
            latest.map((post) => <PostCard {post} />)
          ) : (
            <p class="empty-note">还没有文章。在 content/posts/ 里新建一个 .md 文件就能发布。</p>
          )
        }
        {
          posts.length > latest.length && (
            <p class="more">
              <a href="/posts/">查看全部 {posts.length} 篇 →</a>
            </p>
          )
        }
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* 窄屏：单列，脉络图排在最后。
     宽屏：右栏跟文章页的目录栏同宽同位置，页面之间才不会横向错位 */
  .home {
    display: grid;
    gap: 0 3rem;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'masthead'
      'main'
      'rail';
  }

  @media (min-width: 67rem) {
    .home {
      grid-template-columns: minmax(0, var(--column)) 13rem;
      grid-template-areas:
        'masthead rail'
        'main     rail';
      justify-content: start;
    }
  }

  .masthead {
    grid-area: masthead;
  }

  .main {
    grid-area: main;
    min-width: 0;
  }

  .rail {
    grid-area: rail;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px dashed var(--rule);
  }

  @media (min-width: 67rem) {
    .rail {
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
    }

    /* 三张图叠起来可能比视口高，超出部分让它自己滚，
       跟文章页的目录栏一个处理 */
    .rail-inner {
      position: sticky;
      top: 5rem;
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
    }
  }

  .rail-stack {
    display: grid;
    gap: 1.5rem;
  }

  /* 窄屏下图片会被拉到整页宽，一张树状图撑那么大没意义，收一收 */
  .rail-inner {
    max-width: 22rem;
  }

  @media (min-width: 67rem) {
    .rail-inner {
      max-width: none;
    }
  }

  .rail-note {
    margin: 1.25rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.75rem;
  }

  .rail-note a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .rail-note a:hover {
    color: var(--accent);
  }

  .masthead {
    padding-block: 1.5rem 3.25rem;
  }

  .masthead-kicker {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    color: var(--ink-faint);
  }

  .masthead-title {
    position: relative;
    isolation: isolate;
    display: inline-block;
    margin: 0 0 1.2rem;
    padding-bottom: 0.12em;
    font-size: clamp(3rem, 7vw, 5rem);
    line-height: 1.12;
    letter-spacing: 0.025em;
  }

  .masthead-title::after {
    content: '';
    position: absolute;
    z-index: -1;
    left: -0.03em;
    right: -0.08em;
    bottom: 0.02em;
    height: 0.18em;
    background-image: var(--title-brush);
    background-position: center;
    background-repeat: no-repeat;
    background-size: 100% 100%;
    opacity: 0.72;
  }

  .masthead-lede {
    max-width: var(--measure);
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .categories {
    display: grid;
    border-block: 1px solid var(--rule);
    margin-bottom: 3rem;
  }

  @media (min-width: 40rem) {
    .categories {
      grid-template-columns: repeat(3, 1fr);
    }

    .cat + .cat {
      border-left: 1px dashed var(--rule);
    }
  }

  .cat {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.35rem 1rem;
    background: transparent;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .cat + .cat {
    border-top: 1px dashed var(--rule);
  }

  @media (min-width: 40rem) {
    .cat + .cat {
      border-top: 0;
    }
  }

  .cat:hover {
    color: var(--accent);
  }

  .cat-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent-warm);
  }

  .cat:hover .cat-name {
    color: var(--accent);
  }

  .cat-desc {
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .cat-count {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }

  .more {
    margin: 1.75rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .featured-project {
    display: grid;
    gap: 1.25rem 2rem;
    margin: 0 0 3.25rem;
    padding: 1.6rem 0;
    border-block: 1px dashed var(--rule);
  }

  @media (min-width: 40rem) {
    .featured-project {
      grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.7fr);
      align-items: end;
    }
  }

  .featured-label {
    margin: 0 0 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--accent-warm);
  }

  .featured-copy h2 {
    margin-bottom: 0.35rem;
    font-size: 1.65rem;
  }

  .featured-copy p:not(.featured-label) {
    margin: 0 0 0.75rem;
    color: var(--ink-soft);
  }

  .featured-copy a {
    font-family: var(--font-ui);
    font-size: 0.84rem;
    color: var(--accent);
  }

  .featured-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    justify-content: flex-start;
  }

  @media (min-width: 40rem) {
    .featured-proof {
      justify-content: flex-end;
    }
  }

  .featured-proof span {
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-muted);
    background: var(--paper-raised);
  }

  .more a {
    text-decoration: none;
    color: var(--ink-soft);
  }

  .more a:hover {
    color: var(--accent);
  }

  :global(:root[data-theme='dark']) .masthead-title::after {
    opacity: 0.82;
  }

  @media (max-width: 40rem) {
    .masthead {
      padding-block: 0.75rem 2.5rem;
    }

    .masthead-title {
      font-size: clamp(3rem, 16vw, 4rem);
    }

    .masthead-lede {
      font-size: 1rem;
    }
  }
</style>
