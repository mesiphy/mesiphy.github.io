---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getPosts, groupByCategory, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();

  // 同一栏目内按时间倒序：i-1 更新，i+1 更旧。
  return groupByCategory(posts).flatMap(({ posts: items }) => items.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: items[i + 1],
      next: items[i - 1],
    },
  })));
}

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout {post} {headings} {prev} {next}>
  <Content />
</PostLayout>
